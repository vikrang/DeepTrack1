# DeepTrack configuration
# Copy this file to ".env" (same folder as run.py) and fill in the values.
# ".env" is ignored by git and never shipped in the ZIP.

# ---- Local server -----------------------------------------------------------
# DEEPTRACK_HOST=127.0.0.1
# DEEPTRACK_PORT=5000
# DEEPTRACK_OPEN_BROWSER=1

# ---- Google sign-in (Firebase) ---------------------------------------------
# Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
DEEPTRACK_FIREBASE_PROJECT=
DEEPTRACK_FIREBASE_API_KEY=
DEEPTRACK_FIREBASE_AUTH_DOMAIN=
# DEEPTRACK_FIREBASE_APP_ID=

# Comma-separated Google accounts allowed to sign in (sign-in stays off while empty)
DEEPTRACK_ALLOWED_EMAILS=
# Subset of the allowlist that always gets admin (optional)
DEEPTRACK_ADMIN_EMAILS=

# Keep on for local use; set to 0 on a hosted instance so only Google works
# DEEPTRACK_PASSWORD_LOGIN=0

# ---- Hosted instances only --------------------------------------------------
# Mark session cookies Secure when served over HTTPS
# DEEPTRACK_HTTPS=1
# Use a persistent signing key instead of the generated data/secret.key
# DEEPTRACK_SECRET_KEY=
# Where the SQLite database lives (must be a persistent disk when hosted)
# DEEPTRACK_DATA_DIR=/var/data
# DEEPTRACK_DB=/var/data/tracker.db

# ---- Firebase cloud storage (data always lives in the cloud) ----------------
# Requires DEEPTRACK_FIREBASE_PROJECT above, a Firestore database, and a service
# account. See docs/DEPLOYMENT.md -> "Firebase cloud storage". With these set,
# every change is written to Firestore and reloaded on startup, so the portfolio
# is cloud-backed no matter where the app runs. Leave blank to stay local-only.
# Path to a service-account JSON key file (local use):
# DEEPTRACK_FIREBASE_CREDENTIALS=/path/to/serviceAccount.json
# ...or paste the whole service-account JSON on one line (hosted use, e.g. Render):
# DEEPTRACK_FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
